PORT=3000

# Optional TURN relay for strict NATs and mobile networks.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=kotomaster
# TURN_CREDENTIAL=temporary-password

# Preferred for coturn with TURN REST API: server generates one-hour credentials.
# TURN_SHARED_SECRET=your-coturn-static-auth-secret
# The username prefix is TURN_USERNAME (defaults to kotomaster).

# Optional. Keep "all" unless testing a TURN server.
# ICE_TRANSPORT_POLICY=all
