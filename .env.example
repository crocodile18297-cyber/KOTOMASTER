PORT=3000

# Optional TURN relay for strict NATs and mobile networks.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=kotomaster
# TURN_CREDENTIAL=temporary-password

# Preferred for coturn with TURN REST API: server generates one-hour credentials.
# TURN_SHARED_SECRET=your-coturn-static-auth-secret
# The username prefix is TURN_USERNAME (defaults to kotomaster).

# Optional managed Cloudflare TURN relay. Create a TURN key in Cloudflare Realtime.
# Keep both values in Render Environment only; never commit real keys.
# CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
# CLOUDFLARE_TURN_API_TOKEN=your_turn_key_api_token
# KOTOMASTER requests short-lived credentials and exposes them only to signed-in clients.

# Optional. Keep "all" unless testing a TURN server.
# ICE_TRANSPORT_POLICY=all

# PostHog product analytics (EU Cloud).
# Public project token; set the real value in Render, never commit it here.
# POSTHOG_PROJECT_TOKEN=phc_your_project_token
POSTHOG_API_HOST=https://eu.i.posthog.com
